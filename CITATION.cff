    given-names: David M.
    affiliation: University of Sussex
    orcid: "https://orcid.org/0000-0002-7737-5586"
repository-code: "https://github.com/vector-lab-tools/vector-abliteration-units"
license: GPL-3.0-or-later
version: 0.3.0
date-released: 2026-11-24
